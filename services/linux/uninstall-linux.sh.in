#!/usr/bin/env bash
set -euo pipefail

APP="@APP@"
INSTALL_DIR="@INSTALL_DIR@"
CONFIG_DIR="@CONFIG_DIR@"
CONFIG_PATH="@CONFIG_PATH@"
TLS_DIR="@TLS_DIR@"
SERVICE_USER="@SERVICE_USER@"
SERVICE_GROUP="@SERVICE_GROUP@"

FBS_SOURCE_IP="@FBS_SOURCE_IP@"
FBS_PORT_RANGE="@FBS_PORT_RANGE@"

SERVICE_NAME="${APP}.service"
UPDATE_SERVICE_NAME="${APP}-update.service"
UPDATE_TIMER_NAME="${APP}-update.timer"

SERVICE_PATH="/etc/systemd/system/${SERVICE_NAME}"
UPDATE_SERVICE_PATH="/etc/systemd/system/${UPDATE_SERVICE_NAME}"
UPDATE_TIMER_PATH="/etc/systemd/system/${UPDATE_TIMER_NAME}"

EXPECTED_UFW_RULE="ufw allow from ${FBS_SOURCE_IP} to any port ${FBS_PORT_RANGE} proto tcp"
PURGE=false

usage() {
  cat <<USAGE
Usage: sudo ./uninstall.sh [--purge]

Without --purge, the production configuration and gateway TLS files are kept.

Options:
  --purge    Also remove ${CONFIG_DIR}, including config.yaml and TLS files.
  -h, --help Show this help text.
USAGE
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --purge)
      PURGE=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: Unknown option: $1"
      usage
      exit 2
      ;;
  esac
  shift
done

if [[ "$(id -u)" -ne 0 ]]; then
  escalation_args=()
  if [[ "$PURGE" == true ]]; then
    escalation_args+=(--purge)
  fi

  if command -v pkexec >/dev/null 2>&1; then
    exec pkexec env \
      DISPLAY="${DISPLAY:-}" \
      XAUTHORITY="${XAUTHORITY:-}" \
      bash "$0" "${escalation_args[@]}"
  fi

  if command -v sudo >/dev/null 2>&1; then
    exec sudo "$0" "${escalation_args[@]}"
  fi

  echo "ERROR: Administrator privileges are required."
  echo "Run this script as root."
  exit 1
fi

unit_exists() {
  systemctl cat "$1" >/dev/null 2>&1
}

stop_and_disable_unit() {
  local unit_name="$1"
  local description="$2"

  if ! command -v systemctl >/dev/null 2>&1; then
    echo "WARNING: systemctl is unavailable; cannot stop ${description}."
    return
  fi

  if unit_exists "$unit_name"; then
    echo "Stopping and disabling ${description}..."
    systemctl disable --now "$unit_name" >/dev/null 2>&1 || {
      systemctl stop "$unit_name" >/dev/null 2>&1 || true
      systemctl disable "$unit_name" >/dev/null 2>&1 || true
    }
  fi
}

remove_gateway_firewall_rule() {
  local added_rules=""

  if ! command -v ufw >/dev/null 2>&1; then
    echo "WARNING: ufw is unavailable; the gateway firewall rule could not be checked."
    return
  fi

  echo "Removing the gateway-specific UFW rule..."

  while true; do
    added_rules="$(ufw show added 2>/dev/null || true)"

    if ! grep -Fqx "$EXPECTED_UFW_RULE" <<<"$added_rules"; then
      break
    fi

    if ! ufw --force delete allow \
      from "$FBS_SOURCE_IP" \
      to any \
      port "$FBS_PORT_RANGE" \
      proto tcp; then
      echo "WARNING: Could not remove the gateway-specific UFW rule."
      break
    fi
  done
}

stop_and_disable_unit "$UPDATE_TIMER_NAME" "automatic update timer"
stop_and_disable_unit "$UPDATE_SERVICE_NAME" "automatic update service"
stop_and_disable_unit "$SERVICE_NAME" "gateway service"

remove_gateway_firewall_rule

echo "Removing systemd unit files..."
rm -f \
  "$SERVICE_PATH" \
  "$UPDATE_SERVICE_PATH" \
  "$UPDATE_TIMER_PATH"

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload
  systemctl reset-failed \
    "$SERVICE_NAME" \
    "$UPDATE_SERVICE_NAME" \
    "$UPDATE_TIMER_NAME" \
    >/dev/null 2>&1 || true
fi

echo "Removing installed application files..."
rm -rf "$INSTALL_DIR"

if [[ "$PURGE" == true ]]; then
  echo "Purging configuration and gateway TLS files..."
  rm -rf "$CONFIG_DIR"
fi

echo
echo "Uninstall complete."

if [[ "$PURGE" == false ]]; then
  echo "The production configuration was preserved at:"
  echo "  $CONFIG_PATH"
  echo "The gateway TLS files were preserved at:"
  echo "  $TLS_DIR"
else
  echo "Persistent gateway configuration and TLS data were removed."
fi

echo "The ${SERVICE_USER} service account and ${SERVICE_GROUP} group were preserved for safe reinstallation."
echo "Existing journald entries remain subject to the system journal retention policy."
