#!/usr/bin/env bash
set -euo pipefail

APP="@APP@"
INSTALL_DIR="@INSTALL_DIR@"
CONFIG_DIR="@CONFIG_DIR@"
CONFIG_PATH="@CONFIG_PATH@"
STATE_DIR="/var/lib/${APP}"
DB_PATH="${STATE_DIR}/gateway.db"
TLS_DIR="@TLS_DIR@"
SERVICE_USER="@SERVICE_USER@"
SERVICE_GROUP="@SERVICE_GROUP@"
SERVICE_NAME="${APP}.service"

FBS_SOURCE_IP="@FBS_SOURCE_IP@"
FBS_PORT_RANGE="@FBS_PORT_RANGE@"
ADMIN_STATUS_URL="http://127.0.0.1:18090/api/status"

REQUIRED_PACKAGES=(
  lsof
  curl
  ca-certificates
  ufw
)

EXPECTED_UFW_RULE="ufw allow from ${FBS_SOURCE_IP} to any port ${FBS_PORT_RANGE} proto tcp"

SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BIN_SRC="${SOURCE_DIR}/${APP}"
CONFIG_SRC="${SOURCE_DIR}/config.yaml"
SERVICE_SRC="${SOURCE_DIR}/${SERVICE_NAME}"
UNINSTALL_SRC="${SOURCE_DIR}/uninstall.sh"
UPDATE_SRC="${SOURCE_DIR}/update.sh"

TLS_SRC="${SOURCE_DIR}/tls"
SERVER_CA_SRC="${TLS_SRC}/server-ca.crt"
CLIENT_CERT_SRC="${TLS_SRC}/gateway-client.crt"
CLIENT_KEY_SRC="${TLS_SRC}/gateway-client.key"

SERVER_CA_PATH="${TLS_DIR}/server-ca.crt"
CLIENT_CERT_PATH="${TLS_DIR}/gateway-client.crt"
CLIENT_KEY_PATH="${TLS_DIR}/gateway-client.key"

SERVICE_PATH="/etc/systemd/system/${SERVICE_NAME}"
UPDATE_SERVICE_SRC="${SOURCE_DIR}/${APP}-update.service"
UPDATE_TIMER_SRC="${SOURCE_DIR}/${APP}-update.timer"
UPDATE_SERVICE_NAME="${APP}-update.service"
UPDATE_TIMER_NAME="${APP}-update.timer"
UPDATE_SERVICE_PATH="/etc/systemd/system/${UPDATE_SERVICE_NAME}"
UPDATE_TIMER_PATH="/etc/systemd/system/${UPDATE_TIMER_NAME}"

DEVELOPMENT_INSTALL=false

usage() {
  cat <<USAGE
Usage: sudo ./install.sh [--development]

  --development  Install the local build while disabling managed updates.
USAGE
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --development)
      DEVELOPMENT_INSTALL=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: Unknown option: $1"
      usage
      exit 2
      ;;
  esac
  shift
done

if [[ "$(id -u)" -ne 0 ]]; then
  escalation_args=()
  if [[ "$DEVELOPMENT_INSTALL" == true ]]; then
    escalation_args+=(--development)
  fi

  if command -v pkexec >/dev/null 2>&1; then
    exec pkexec env \
      DISPLAY="${DISPLAY:-}" \
      XAUTHORITY="${XAUTHORITY:-}" \
      bash "$0" "${escalation_args[@]}"
  fi

  if command -v sudo >/dev/null 2>&1; then
    exec sudo "$0" "${escalation_args[@]}"
  fi

  echo "ERROR: Administrator privileges are required."
  echo "Run this script as root."
  exit 1
fi

echo "Installing ${APP} from:"
echo "  ${SOURCE_DIR}"
if [[ "$DEVELOPMENT_INSTALL" == true ]]; then
  echo "Mode: development"
else
  echo "Mode: production"
fi
echo

require_file() {
  local path="$1"
  local description="$2"

  if [[ ! -f "$path" ]]; then
    echo "ERROR: Missing ${description}:"
    echo "  ${path}"
    exit 1
  fi
}

install_missing_dependencies() {
  local missing_packages=()
  local package=""
  local package_status=""

  if ! command -v dpkg-query >/dev/null 2>&1; then
    echo "ERROR: dpkg-query is required to check installed packages."
    exit 1
  fi

  for package in "${REQUIRED_PACKAGES[@]}"; do
    package_status="$(
      dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true
    )"

    if [[ "$package_status" != "install ok installed" ]]; then
      missing_packages+=("$package")
    fi
  done

  if [[ "${#missing_packages[@]}" -eq 0 ]]; then
    echo "Required dependencies are already installed."
    echo
    return
  fi

  if ! command -v apt-get >/dev/null 2>&1; then
    echo "ERROR: apt-get is required to install missing dependencies."
    echo "Missing packages:"
    printf '  %s\n' "${missing_packages[@]}"
    exit 1
  fi

  echo "Installing missing dependencies:"
  printf '  %s\n' "${missing_packages[@]}"
  echo

  apt-get update

  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    --no-install-recommends \
    "${missing_packages[@]}"

  echo
  echo "Dependency installation complete."
  echo
}

configure_ufw() {
  local current_input_policy=""
  local current_output_policy=""
  local added_rules=""

  if ! command -v ufw >/dev/null 2>&1; then
    echo "ERROR: ufw is required but is not available."
    exit 1
  fi

  echo "Checking UFW configuration..."

  if [[ -r /etc/default/ufw ]]; then
    current_input_policy="$(
      sed -n \
        's/^[[:space:]]*DEFAULT_INPUT_POLICY="\([^"]*\)".*/\1/p' \
        /etc/default/ufw |
        head -n 1
    )"

    current_output_policy="$(
      sed -n \
        's/^[[:space:]]*DEFAULT_OUTPUT_POLICY="\([^"]*\)".*/\1/p' \
        /etc/default/ufw |
        head -n 1
    )"
  fi

  if [[ "$current_input_policy" != "DROP" ]]; then
    echo "Setting the default incoming policy to deny..."
    ufw default deny incoming
  else
    echo "Default incoming policy is already set to deny."
  fi

  if [[ "$current_output_policy" != "ACCEPT" ]]; then
    echo "Setting the default outgoing policy to allow..."
    ufw default allow outgoing
  else
    echo "Default outgoing policy is already set to allow."
  fi

  added_rules="$(ufw show added 2>/dev/null || true)"

  if grep -Fqx "$EXPECTED_UFW_RULE" <<<"$added_rules"; then
    echo "Required FBS firewall rule is already present."
  else
    echo "Adding the required FBS firewall rule..."

    ufw allow \
      from "$FBS_SOURCE_IP" \
      to any \
      port "$FBS_PORT_RANGE" \
      proto tcp
  fi

  if [[ -r /etc/ufw/ufw.conf ]] &&
    grep -Eq '^[[:space:]]*ENABLED=yes[[:space:]]*$' /etc/ufw/ufw.conf; then
    echo "UFW is already enabled."
  else
    echo "Enabling UFW..."
    ufw --force enable
  fi

  echo
  echo "Current UFW configuration:"
  ufw status verbose
  echo
}

unit_exists() {
  systemctl cat "$1" >/dev/null 2>&1
}

unit_enabled() {
  systemctl is-enabled --quiet "$1" >/dev/null 2>&1
}

unit_active() {
  systemctl is-active --quiet "$1" >/dev/null 2>&1
}

stop_unit() {
  local unit_name="$1"

  if unit_exists "$unit_name" || unit_active "$unit_name"; then
    systemctl stop "$unit_name" >/dev/null 2>&1 || true
  fi
}

wait_for_admin() {
  local attempt=0

  while [[ "$attempt" -lt 20 ]]; do
    if curl \
      --fail \
      --silent \
      --show-error \
      --max-time 2 \
      "$ADMIN_STATUS_URL" >/dev/null 2>&1; then
      return 0
    fi

    attempt=$((attempt + 1))
    sleep 1
  done

  return 1
}

verify_database_directory_access() {
  local write_test="${STATE_DIR}/.gateway-write-test.$$"

  echo "Verifying SQLite storage access as ${SERVICE_USER}..."

  if ! (
    cd /
    runuser -u "$SERVICE_USER" -- touch "$write_test"
  ); then
    echo "ERROR: Service user cannot create files in:"
    echo "  $STATE_DIR"
    rm -f "$write_test"
    return 1
  fi

  if ! (
    cd /
    runuser -u "$SERVICE_USER" -- rm -f "$write_test"
  ); then
    echo "ERROR: Service user cannot remove files from:"
    echo "  $STATE_DIR"
    rm -f "$write_test"
    return 1
  fi
}

verify_database_file() {
  echo "Verifying the SQLite configuration database..."

  if [[ ! -s "$DB_PATH" ]]; then
    echo "ERROR: Gateway did not create a non-empty SQLite database:"
    echo "  $DB_PATH"
    return 1
  fi

  if ! (
    cd /
    runuser -u "$SERVICE_USER" -- /bin/sh -c \
      'test -r "$1" && test -w "$1"' sh "$DB_PATH"
  ); then
    echo "ERROR: Service user cannot read and write:"
    echo "  $DB_PATH"
    return 1
  fi
}

BACKUP_DIR="$(mktemp -d)"
MAIN_WAS_ENABLED=false
MAIN_WAS_ACTIVE=false
UPDATE_TIMER_WAS_ENABLED=false
UPDATE_TIMER_WAS_ACTIVE=false
ROLLBACK_ACTIVE=false

cleanup() {
  rm -rf "$BACKUP_DIR"
}
trap cleanup EXIT

backup_path() {
  local path="$1"
  local key="$2"

  if [[ -e "$path" ]]; then
    cp -a "$path" "$BACKUP_DIR/$key"
  else
    : > "$BACKUP_DIR/$key.absent"
  fi
}

restore_path() {
  local path="$1"
  local key="$2"

  if [[ -e "$BACKUP_DIR/$key" ]]; then
    rm -rf "$path"
    mkdir -p "$(dirname "$path")"
    cp -a "$BACKUP_DIR/$key" "$path"
  elif [[ -e "$BACKUP_DIR/$key.absent" ]]; then
    rm -rf "$path"
  fi
}

restore_unit_state() {
  local unit_name="$1"
  local was_enabled="$2"
  local was_active="$3"

  if [[ "$was_enabled" == true ]]; then
    systemctl enable "$unit_name" >/dev/null 2>&1 || true
  else
    systemctl disable "$unit_name" >/dev/null 2>&1 || true
  fi

  if [[ "$was_active" == true ]]; then
    systemctl start "$unit_name" >/dev/null 2>&1 || true
  fi
}

rollback_install() {
  if [[ "$ROLLBACK_ACTIVE" == true ]]; then
    return
  fi
  ROLLBACK_ACTIVE=true

  echo
  echo "Rolling back the failed Linux installation..."

  set +e
  stop_unit "$UPDATE_TIMER_NAME"
  stop_unit "$UPDATE_SERVICE_NAME"
  stop_unit "$SERVICE_NAME"

  restore_path "$INSTALL_DIR" "install-dir"
  restore_path "$SERVICE_PATH" "main-service"
  restore_path "$UPDATE_SERVICE_PATH" "update-service"
  restore_path "$UPDATE_TIMER_PATH" "update-timer"

  rm -f "${DB_PATH}-journal" "${DB_PATH}-wal" "${DB_PATH}-shm"
  restore_path "$DB_PATH" "gateway-db"

  systemctl daemon-reload >/dev/null 2>&1 || true
  restore_unit_state "$SERVICE_NAME" "$MAIN_WAS_ENABLED" "$MAIN_WAS_ACTIVE"
  restore_unit_state "$UPDATE_TIMER_NAME" "$UPDATE_TIMER_WAS_ENABLED" "$UPDATE_TIMER_WAS_ACTIVE"
  systemctl reset-failed \
    "$SERVICE_NAME" \
    "$UPDATE_SERVICE_NAME" \
    "$UPDATE_TIMER_NAME" \
    >/dev/null 2>&1 || true
  set -e
}

install_missing_dependencies
configure_ufw

require_file "$BIN_SRC" "application binary"
require_file "$CONFIG_SRC" "config file"
require_file "$SERVICE_SRC" "systemd service file"
require_file "$UNINSTALL_SRC" "uninstaller"
require_file "$SERVER_CA_SRC" "Shelly server CA certificate"
require_file "$CLIENT_CERT_SRC" "gateway client certificate"
require_file "$CLIENT_KEY_SRC" "gateway client private key"

if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  require_file "$UPDATE_SRC" "update script"
  require_file "$UPDATE_SERVICE_SRC" "auto-update systemd service"
  require_file "$UPDATE_TIMER_SRC" "auto-update systemd timer"
fi

echo "Validating application binary..."
"$BIN_SRC" -version

echo "Creating service group/user if needed..."

if ! getent group "$SERVICE_GROUP" >/dev/null; then
  groupadd --system "$SERVICE_GROUP"
fi

if ! id "$SERVICE_USER" >/dev/null 2>&1; then
  useradd \
    --system \
    --no-create-home \
    --home-dir "$INSTALL_DIR" \
    --shell /usr/sbin/nologin \
    --gid "$SERVICE_GROUP" \
    "$SERVICE_USER"
fi

if unit_enabled "$SERVICE_NAME"; then
  MAIN_WAS_ENABLED=true
fi
if unit_active "$SERVICE_NAME"; then
  MAIN_WAS_ACTIVE=true
fi
if unit_enabled "$UPDATE_TIMER_NAME"; then
  UPDATE_TIMER_WAS_ENABLED=true
fi
if unit_active "$UPDATE_TIMER_NAME"; then
  UPDATE_TIMER_WAS_ACTIVE=true
fi

echo "Stopping existing systemd units..."
stop_unit "$UPDATE_TIMER_NAME"
stop_unit "$UPDATE_SERVICE_NAME"
stop_unit "$SERVICE_NAME"

backup_path "$INSTALL_DIR" "install-dir"
backup_path "$SERVICE_PATH" "main-service"
backup_path "$UPDATE_SERVICE_PATH" "update-service"
backup_path "$UPDATE_TIMER_PATH" "update-timer"
backup_path "$DB_PATH" "gateway-db"

echo "Creating install directory..."
install -d \
  -o root \
  -g "$SERVICE_GROUP" \
  -m 0750 \
  "$INSTALL_DIR"

echo "Installing application binary..."
install \
  -o root \
  -g root \
  -m 0755 \
  "$BIN_SRC" \
  "$INSTALL_DIR/$APP"

echo "Installing uninstall.sh..."
install \
  -o root \
  -g root \
  -m 0755 \
  "$UNINSTALL_SRC" \
  "$INSTALL_DIR/uninstall.sh"

if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  echo "Installing checksum-aware updater..."
  install \
    -o root \
    -g root \
    -m 0755 \
    "$UPDATE_SRC" \
    "$INSTALL_DIR/update.sh"
else
  echo "Development install: removing managed updater files..."
  rm -f \
    "$INSTALL_DIR/update.sh" \
    "$UPDATE_SERVICE_PATH" \
    "$UPDATE_TIMER_PATH"
  systemctl disable "$UPDATE_TIMER_NAME" "$UPDATE_SERVICE_NAME" \
    >/dev/null 2>&1 || true
fi

echo "Creating config directory..."
install -d \
  -o "$SERVICE_USER" \
  -g "$SERVICE_GROUP" \
  -m 0750 \
  "$CONFIG_DIR"

echo "Creating persistent state directory..."
install -d \
  -o "$SERVICE_USER" \
  -g "$SERVICE_GROUP" \
  -m 0750 \
  "$STATE_DIR"

echo "Creating TLS directory..."
install -d \
  -o root \
  -g "$SERVICE_GROUP" \
  -m 0750 \
  "$TLS_DIR"

install_tls_file() {
  local source_path="$1"
  local destination_path="$2"
  local mode="$3"
  local description="$4"

  if [[ ! -f "$destination_path" ]]; then
    echo "Installing ${description}..."

    install \
      -o root \
      -g "$SERVICE_GROUP" \
      -m "$mode" \
      "$source_path" \
      "$destination_path"
  else
    echo "Existing ${description} found; preserving:"
    echo "  $destination_path"

    chown "root:$SERVICE_GROUP" "$destination_path"
    chmod "$mode" "$destination_path"
  fi
}

install_tls_file \
  "$SERVER_CA_SRC" \
  "$SERVER_CA_PATH" \
  0640 \
  "Shelly server CA certificate"

install_tls_file \
  "$CLIENT_CERT_SRC" \
  "$CLIENT_CERT_PATH" \
  0640 \
  "gateway client certificate"

install_tls_file \
  "$CLIENT_KEY_SRC" \
  "$CLIENT_KEY_PATH" \
  0640 \
  "gateway client private key"

echo "Installing config.yaml..."

if [[ ! -f "$CONFIG_PATH" ]]; then
  install \
    -o "$SERVICE_USER" \
    -g "$SERVICE_GROUP" \
    -m 0640 \
    "$CONFIG_SRC" \
    "$CONFIG_PATH"
else
  echo "Existing config found; preserving:"
  echo "  $CONFIG_PATH"

  chown "$SERVICE_USER:$SERVICE_GROUP" "$CONFIG_PATH"
  chmod 0640 "$CONFIG_PATH"
fi

echo "Verifying configuration and TLS access as ${SERVICE_USER}..."
for readable_path in \
  "$CONFIG_PATH" \
  "$SERVER_CA_PATH" \
  "$CLIENT_CERT_PATH" \
  "$CLIENT_KEY_PATH"
do
  if ! runuser -u "$SERVICE_USER" -- test -r "$readable_path"; then
    echo "ERROR: Service user cannot read:"
    echo "  $readable_path"
    rollback_install
    exit 1
  fi
done

if ! verify_database_directory_access; then
  rollback_install
  exit 1
fi

echo "Installing systemd service..."
install \
  -o root \
  -g root \
  -m 0644 \
  "$SERVICE_SRC" \
  "$SERVICE_PATH"

if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  echo "Installing auto-update service..."
  install \
    -o root \
    -g root \
    -m 0644 \
    "$UPDATE_SERVICE_SRC" \
    "$UPDATE_SERVICE_PATH"

  echo "Installing auto-update timer..."
  install \
    -o root \
    -g root \
    -m 0644 \
    "$UPDATE_TIMER_SRC" \
    "$UPDATE_TIMER_PATH"
fi

echo "Reloading systemd..."
systemctl daemon-reload

echo "Enabling gateway service..."
systemctl enable "$SERVICE_NAME"

echo "Starting gateway service..."
if ! systemctl restart "$SERVICE_NAME"; then
  echo "ERROR: Gateway service could not be started."
  rollback_install
  exit 1
fi

if ! wait_for_admin; then
  echo "ERROR: The Admin API did not become ready."
  systemctl --no-pager --full status "$SERVICE_NAME" || true
  journalctl -u "$SERVICE_NAME" -n 100 --no-pager || true
  rollback_install
  exit 1
fi

if ! verify_database_file; then
  rollback_install
  exit 1
fi

if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  echo "Enabling hourly auto-update timer..."
  if ! systemctl enable --now "$UPDATE_TIMER_NAME"; then
    echo "ERROR: The auto-update timer could not be enabled."
    rollback_install
    exit 1
  fi
else
  echo "Managed automatic updates remain disabled for development testing."
fi

echo
echo "Installed binary:"
"$INSTALL_DIR/$APP" -version
echo
echo "Gateway service:"
systemctl --no-pager --full status "$SERVICE_NAME" || true
echo
echo "Admin API is responding at:"
echo "  ${ADMIN_STATUS_URL}"
echo
echo "Authoritative SQLite configuration:"
echo "  ${DB_PATH}"
echo "Legacy YAML / rollback mirror:"
echo "  ${CONFIG_PATH}"
echo "Gateway TLS:"
echo "  ${TLS_DIR}"
echo

if [[ "$DEVELOPMENT_INSTALL" == true ]]; then
  echo "Development install complete."
  echo "Run the normal install.sh to restore managed auto-updates."
else
  echo "Production install complete."
fi

echo "Uninstaller: ${INSTALL_DIR}/uninstall.sh"
