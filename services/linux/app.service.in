[Unit]
Description=FBS Interlock Gateway
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
# Relative paths in config.yaml, including ./tls/..., resolve from here.
WorkingDirectory=@CONFIG_DIR@
# Persistent mutable state belongs under /var/lib; systemd also creates and
# maintains this directory for fresh installs and reboots.
StateDirectory=@APP@
StateDirectoryMode=0750
ExecStart=@INSTALL_DIR@/@APP@ -config @CONFIG_PATH@ -db /var/lib/@APP@/gateway.db

StandardOutput=journal
StandardError=journal
SyslogIdentifier=@APP@

LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

Restart=always
RestartSec=2

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
