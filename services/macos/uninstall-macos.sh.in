#!/bin/bash
set -euo pipefail

APP="@APP@"
INSTALL_DIR="@MACOS_INSTALL_DIR@"
CONFIG_DIR="@MACOS_CONFIG_DIR@"
CONFIG_PATH="@MACOS_CONFIG_PATH@"
TLS_DIR="@MACOS_TLS_DIR@"
LOG_DIR="@MACOS_LOG_DIR@"

LAUNCHD_LABEL="@MACOS_LAUNCHD_LABEL@"
UPDATE_LAUNCHD_LABEL="@MACOS_UPDATE_LAUNCHD_LABEL@"
PLIST_PATH="/Library/LaunchDaemons/${LAUNCHD_LABEL}.plist"
UPDATE_PLIST_PATH="/Library/LaunchDaemons/${UPDATE_LAUNCHD_LABEL}.plist"

PF_ANCHOR_NAME="@MACOS_PF_ANCHOR_NAME@"
PF_ANCHOR_PATH="@MACOS_PF_ANCHOR_PATH@"
PF_CONF="/etc/pf.conf"
PF_BEGIN="# BEGIN ${APP} managed anchor"
PF_END="# END ${APP} managed anchor"

FIREWALL_TOOL="/usr/libexec/ApplicationFirewall/socketfilterfw"
PURGE=false

usage() {
  cat <<USAGE
Usage: sudo ./uninstall.sh [--purge]

Without --purge, the production configuration, TLS files, and logs are kept.
USAGE
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --purge)
      PURGE=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: Unknown option: $1"
      usage
      exit 2
      ;;
  esac
  shift
done

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "ERROR: This uninstaller must be run on macOS."
  exit 1
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Administrator privileges are required."
  if [[ "$PURGE" == true ]]; then
    exec sudo "$0" --purge
  fi
  exec sudo "$0"
fi

unload_job() {
  local label="$1"
  local plist_path="$2"

  if launchctl print "system/${label}" >/dev/null 2>&1; then
    launchctl bootout system "$plist_path" >/dev/null 2>&1 ||
      launchctl bootout "system/${label}" >/dev/null 2>&1 ||
      true
  fi

  launchctl disable "system/${label}" >/dev/null 2>&1 || true
}

remove_packet_filter_anchor() {
  local temp_conf=""

  if [[ ! -f "$PF_CONF" ]] || ! grep -Fqx "$PF_BEGIN" "$PF_CONF"; then
    rm -f "$PF_ANCHOR_PATH"
    return
  fi

  temp_conf="$(mktemp)"
  awk \
    -v begin="$PF_BEGIN" \
    -v end="$PF_END" \
    '
      $0 == begin { skipping = 1; next }
      $0 == end   { skipping = 0; next }
      !skipping   { print }
    ' \
    "$PF_CONF" > "$temp_conf"

  if /sbin/pfctl -nf "$temp_conf"; then
    install -o root -g wheel -m 0644 "$temp_conf" "$PF_CONF"
    rm -f "$PF_ANCHOR_PATH"
    /sbin/pfctl -f "$PF_CONF"
  else
    echo "WARNING: Refusing to install an invalid packet-filter configuration."
    echo "The existing gateway anchor was left in place."
  fi

  rm -f "$temp_conf"
}

echo "Stopping the update LaunchDaemon..."
unload_job "$UPDATE_LAUNCHD_LABEL" "$UPDATE_PLIST_PATH"

echo "Stopping the gateway LaunchDaemon..."
unload_job "$LAUNCHD_LABEL" "$PLIST_PATH"

if [[ -x "$FIREWALL_TOOL" && -f "$INSTALL_DIR/$APP" ]]; then
  echo "Removing the gateway from the macOS Application Firewall list..."
  "$FIREWALL_TOOL" --remove "$INSTALL_DIR/$APP" >/dev/null 2>&1 || true
fi

echo "Removing the gateway packet-filter anchor..."
remove_packet_filter_anchor

echo "Removing LaunchDaemons and installed executable files..."
rm -f "$PLIST_PATH" "$UPDATE_PLIST_PATH"
rm -rf "$INSTALL_DIR"

if [[ "$PURGE" == true ]]; then
  echo "Purging configuration, TLS files, and logs..."
  rm -rf "$CONFIG_DIR" "$LOG_DIR"
fi

echo
echo "Uninstall complete."
if [[ "$PURGE" == false ]]; then
  echo "The production configuration was preserved at:"
  echo "  $CONFIG_PATH"
  echo "The gateway TLS files were preserved at:"
  echo "  $TLS_DIR"
  echo "The existing logs were preserved at:"
  echo "  $LOG_DIR"
else
  echo "Persistent gateway data was removed."
fi
echo "The hidden service account was preserved for safe reinstallation."
