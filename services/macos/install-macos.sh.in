#!/bin/bash
set -euo pipefail

APP="@APP@"
INSTALL_DIR="@MACOS_INSTALL_DIR@"
CONFIG_DIR="@MACOS_CONFIG_DIR@"
CONFIG_PATH="@MACOS_CONFIG_PATH@"
TLS_DIR="@MACOS_TLS_DIR@"
LOG_DIR="@MACOS_LOG_DIR@"
SERVICE_USER="@MACOS_SERVICE_USER@"
SERVICE_GROUP="@MACOS_SERVICE_GROUP@"

LAUNCHD_LABEL="@MACOS_LAUNCHD_LABEL@"
UPDATE_LAUNCHD_LABEL="@MACOS_UPDATE_LAUNCHD_LABEL@"
PLIST_PATH="/Library/LaunchDaemons/${LAUNCHD_LABEL}.plist"
UPDATE_PLIST_PATH="/Library/LaunchDaemons/${UPDATE_LAUNCHD_LABEL}.plist"

PF_ANCHOR_NAME="@MACOS_PF_ANCHOR_NAME@"
PF_ANCHOR_PATH="@MACOS_PF_ANCHOR_PATH@"
PF_CONF="/etc/pf.conf"
PF_BEGIN="# BEGIN ${APP} managed anchor"
PF_END="# END ${APP} managed anchor"

ADMIN_STATUS_URL="http://127.0.0.1:18090/api/status"
FIREWALL_TOOL="/usr/libexec/ApplicationFirewall/socketfilterfw"

SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_SRC="${SOURCE_DIR}/${APP}"
CONFIG_SRC="${SOURCE_DIR}/config.yaml"
START_SRC="${SOURCE_DIR}/start.sh"
PLIST_SRC="${SOURCE_DIR}/${LAUNCHD_LABEL}.plist"
UPDATE_SRC="${SOURCE_DIR}/update.sh"
UPDATE_PLIST_SRC="${SOURCE_DIR}/${UPDATE_LAUNCHD_LABEL}.plist"
PF_ANCHOR_SRC="${SOURCE_DIR}/${PF_ANCHOR_NAME}.pf"
TLS_SRC="${SOURCE_DIR}/tls"

SERVER_CA_SRC="${TLS_SRC}/server-ca.crt"
CLIENT_CERT_SRC="${TLS_SRC}/gateway-client.crt"
CLIENT_KEY_SRC="${TLS_SRC}/gateway-client.key"

SERVER_CA_PATH="${TLS_DIR}/server-ca.crt"
CLIENT_CERT_PATH="${TLS_DIR}/gateway-client.crt"
CLIENT_KEY_PATH="${TLS_DIR}/gateway-client.key"

DEVELOPMENT_INSTALL=false

usage() {
  cat <<USAGE
Usage: sudo ./install.sh [--development]

  --development  Install the local build while disabling managed updates.
USAGE
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --development)
      DEVELOPMENT_INSTALL=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: Unknown option: $1"
      usage
      exit 2
      ;;
  esac
  shift
done

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "ERROR: This installer must be run on macOS."
  exit 1
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Administrator privileges are required."
  if [[ "$DEVELOPMENT_INSTALL" == true ]]; then
    exec sudo "$0" --development
  fi
  exec sudo "$0"
fi

echo "Installing ${APP} from:"
echo "  ${SOURCE_DIR}"
if [[ "$DEVELOPMENT_INSTALL" == true ]]; then
  echo "Mode: development"
else
  echo "Mode: production"
fi
echo

require_file() {
  local path="$1"
  local description="$2"

  if [[ ! -f "$path" ]]; then
    echo "ERROR: Missing ${description}:"
    echo "  ${path}"
    exit 1
  fi
}

record_exists() {
  local record="$1"
  dscl . -read "$record" >/dev/null 2>&1
}

find_unused_directory_id() {
  local directory="$1"
  local attribute="$2"
  local candidate=499

  while [[ "$candidate" -ge 400 ]]; do
    if ! dscl . -search "$directory" "$attribute" "$candidate" 2>/dev/null |
      grep -q .; then
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate=$((candidate - 1))
  done

  echo "ERROR: Could not find an unused macOS directory ID from 400 through 499." >&2
  return 1
}

create_service_account() {
  local service_gid=""
  local service_uid=""

  echo "Creating the service group and account when needed..."

  if ! record_exists "/Groups/${SERVICE_GROUP}"; then
    service_gid="$(find_unused_directory_id /Groups PrimaryGroupID)"

    dscl . -create "/Groups/${SERVICE_GROUP}"
    dscl . -create "/Groups/${SERVICE_GROUP}" PrimaryGroupID "$service_gid"
    dscl . -create "/Groups/${SERVICE_GROUP}" RealName "FBS Interlock Gateway"
    dscl . -create "/Groups/${SERVICE_GROUP}" Password "*"
  fi

  service_gid="$(
    dscl . -read "/Groups/${SERVICE_GROUP}" PrimaryGroupID |
      awk '{print $2}'
  )"

  if ! record_exists "/Users/${SERVICE_USER}"; then
    service_uid="$(find_unused_directory_id /Users UniqueID)"

    dscl . -create "/Users/${SERVICE_USER}"
    dscl . -create "/Users/${SERVICE_USER}" UniqueID "$service_uid"
    dscl . -create "/Users/${SERVICE_USER}" PrimaryGroupID "$service_gid"
    dscl . -create "/Users/${SERVICE_USER}" RealName "FBS Interlock Gateway"
    dscl . -create "/Users/${SERVICE_USER}" UserShell /usr/bin/false
    dscl . -create "/Users/${SERVICE_USER}" NFSHomeDirectory /var/empty
    dscl . -create "/Users/${SERVICE_USER}" IsHidden 1
    dscl . -create "/Users/${SERVICE_USER}" Password "*"
  fi
}

job_loaded() {
  launchctl print "system/$1" >/dev/null 2>&1
}

unload_job() {
  local label="$1"
  local plist_path="$2"

  if job_loaded "$label"; then
    launchctl bootout system "$plist_path" >/dev/null 2>&1 ||
      launchctl bootout "system/${label}" >/dev/null 2>&1 ||
      true
  fi
}

validate_binary() {
  local machine_arch=""
  local expected_arch=""
  local binary_info=""

  machine_arch="$(uname -m)"

  case "$machine_arch" in
    arm64)
      expected_arch="arm64"
      ;;
    x86_64)
      expected_arch="x86_64"
      ;;
    *)
      echo "ERROR: Unsupported Mac architecture: ${machine_arch}"
      exit 1
      ;;
  esac

  binary_info="$(/usr/bin/file -b "$BIN_SRC")"

  if [[ "$binary_info" != *"Mach-O 64-bit executable ${expected_arch}"* ]]; then
    echo "ERROR: The deployment binary does not match this Mac."
    echo "Expected architecture: ${expected_arch}"
    echo "Binary information:    ${binary_info}"
    exit 1
  fi

  echo "Validating application binary..."
  "$BIN_SRC" -version
}

configure_application_firewall() {
  if [[ ! -x "$FIREWALL_TOOL" ]]; then
    echo "WARNING: macOS Application Firewall tool not found."
    return
  fi

  echo "Registering the gateway with the macOS Application Firewall..."
  "$FIREWALL_TOOL" --add "$INSTALL_DIR/$APP" >/dev/null 2>&1 || true
  "$FIREWALL_TOOL" --unblockapp "$INSTALL_DIR/$APP" >/dev/null 2>&1 || true
}

configure_packet_filter() {
  local anchor_line="anchor \"${PF_ANCHOR_NAME}\""
  local load_line="load anchor \"${PF_ANCHOR_NAME}\" from \"${PF_ANCHOR_PATH}\""
  local temp_conf=""

  echo "Installing the FBS source-IP packet-filter anchor..."
  install -d -o root -g wheel -m 0755 "$(dirname "$PF_ANCHOR_PATH")"
  install -o root -g wheel -m 0644 "$PF_ANCHOR_SRC" "$PF_ANCHOR_PATH"

  temp_conf="$(mktemp)"
  awk \
    -v begin="$PF_BEGIN" \
    -v end="$PF_END" \
    '
      $0 == begin { skipping = 1; next }
      $0 == end   { skipping = 0; next }
      !skipping   { print }
    ' \
    "$PF_CONF" > "$temp_conf"

  {
    echo
    echo "$PF_BEGIN"
    echo "$anchor_line"
    echo "$load_line"
    echo "$PF_END"
  } >> "$temp_conf"

  if ! /sbin/pfctl -nf "$temp_conf"; then
    echo "ERROR: The generated packet-filter configuration is invalid."
    rm -f "$temp_conf"
    return 1
  fi

  install -o root -g wheel -m 0644 "$temp_conf" "$PF_CONF"
  rm -f "$temp_conf"

  /sbin/pfctl -f "$PF_CONF"

  if ! /sbin/pfctl -s info 2>/dev/null |
    grep -Eq '^Status:[[:space:]]+Enabled'; then
    /sbin/pfctl -E >/dev/null
  fi
}

install_tls_file() {
  local source_path="$1"
  local destination_path="$2"
  local description="$3"

  if [[ ! -f "$destination_path" ]]; then
    echo "Installing ${description}..."
    install \
      -o root \
      -g "$SERVICE_GROUP" \
      -m 0640 \
      "$source_path" \
      "$destination_path"
  else
    echo "Existing ${description} found; preserving:"
    echo "  $destination_path"
    chown "root:$SERVICE_GROUP" "$destination_path"
    chmod 0640 "$destination_path"
  fi
}

wait_for_admin() {
  local attempt=0

  while [[ "$attempt" -lt 20 ]]; do
    if curl \
      --fail \
      --silent \
      --show-error \
      --max-time 2 \
      "$ADMIN_STATUS_URL" >/dev/null 2>&1; then
      return 0
    fi

    attempt=$((attempt + 1))
    sleep 1
  done

  return 1
}

BACKUP_DIR="$(mktemp -d)"
MAIN_WAS_LOADED=false
UPDATE_WAS_LOADED=false
ROLLBACK_ACTIVE=false

cleanup() {
  rm -rf "$BACKUP_DIR"
}
trap cleanup EXIT

backup_path() {
  local path="$1"
  local key="$2"

  if [[ -e "$path" ]]; then
    cp -a "$path" "$BACKUP_DIR/$key"
  else
    : > "$BACKUP_DIR/$key.absent"
  fi
}

restore_path() {
  local path="$1"
  local key="$2"

  if [[ -e "$BACKUP_DIR/$key" ]]; then
    rm -rf "$path"
    install -d -m 0755 "$(dirname "$path")"
    cp -a "$BACKUP_DIR/$key" "$path"
  elif [[ -e "$BACKUP_DIR/$key.absent" ]]; then
    rm -rf "$path"
  fi
}

rollback_install() {
  if [[ "$ROLLBACK_ACTIVE" == true ]]; then
    return
  fi
  ROLLBACK_ACTIVE=true

  echo
  echo "Rolling back the failed macOS installation..."

  set +e
  unload_job "$UPDATE_LAUNCHD_LABEL" "$UPDATE_PLIST_PATH"
  unload_job "$LAUNCHD_LABEL" "$PLIST_PATH"

  restore_path "$INSTALL_DIR/$APP" "app"
  restore_path "$INSTALL_DIR/start.sh" "start"
  restore_path "$INSTALL_DIR/update.sh" "update"
  restore_path "$PLIST_PATH" "main-plist"
  restore_path "$UPDATE_PLIST_PATH" "update-plist"
  restore_path "$PF_ANCHOR_PATH" "pf-anchor"
  restore_path "$PF_CONF" "pf-conf"

  /sbin/pfctl -nf "$PF_CONF" >/dev/null 2>&1 &&
    /sbin/pfctl -f "$PF_CONF" >/dev/null 2>&1

  if [[ "$MAIN_WAS_LOADED" == true && -f "$PLIST_PATH" ]]; then
    launchctl bootstrap system "$PLIST_PATH" >/dev/null 2>&1
    launchctl enable "system/${LAUNCHD_LABEL}" >/dev/null 2>&1
    launchctl kickstart -k "system/${LAUNCHD_LABEL}" >/dev/null 2>&1
  fi

  if [[ "$UPDATE_WAS_LOADED" == true && -f "$UPDATE_PLIST_PATH" ]]; then
    launchctl bootstrap system "$UPDATE_PLIST_PATH" >/dev/null 2>&1
    launchctl enable "system/${UPDATE_LAUNCHD_LABEL}" >/dev/null 2>&1
  fi
  set -e
}

require_file "$BIN_SRC" "application binary"
require_file "$CONFIG_SRC" "config file"
require_file "$START_SRC" "startup script"
require_file "$PLIST_SRC" "gateway LaunchDaemon property list"
require_file "$PF_ANCHOR_SRC" "packet-filter anchor"
require_file "$PF_CONF" "macOS packet-filter configuration"
require_file "$SERVER_CA_SRC" "Shelly server CA certificate"
require_file "$CLIENT_CERT_SRC" "gateway client certificate"
require_file "$CLIENT_KEY_SRC" "gateway client private key"

if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  require_file "$UPDATE_SRC" "update script"
  require_file "$UPDATE_PLIST_SRC" "update LaunchDaemon property list"
fi

plutil -lint "$PLIST_SRC" >/dev/null
if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  plutil -lint "$UPDATE_PLIST_SRC" >/dev/null
fi

validate_binary
create_service_account

if job_loaded "$LAUNCHD_LABEL"; then
  MAIN_WAS_LOADED=true
fi
if job_loaded "$UPDATE_LAUNCHD_LABEL"; then
  UPDATE_WAS_LOADED=true
fi

backup_path "$INSTALL_DIR/$APP" "app"
backup_path "$INSTALL_DIR/start.sh" "start"
backup_path "$INSTALL_DIR/update.sh" "update"
backup_path "$PLIST_PATH" "main-plist"
backup_path "$UPDATE_PLIST_PATH" "update-plist"
backup_path "$PF_ANCHOR_PATH" "pf-anchor"
backup_path "$PF_CONF" "pf-conf"

echo "Stopping existing LaunchDaemons..."
unload_job "$UPDATE_LAUNCHD_LABEL" "$UPDATE_PLIST_PATH"
unload_job "$LAUNCHD_LABEL" "$PLIST_PATH"

echo "Creating the application directory..."
install -d -o root -g "$SERVICE_GROUP" -m 0750 "$INSTALL_DIR"

echo "Installing the application binary and startup script..."
install -o root -g wheel -m 0755 "$BIN_SRC" "$INSTALL_DIR/$APP"
install -o root -g wheel -m 0755 "$START_SRC" "$INSTALL_DIR/start.sh"
xattr -d com.apple.quarantine "$INSTALL_DIR/$APP" >/dev/null 2>&1 || true

if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  echo "Installing the checksum-aware updater..."
  install -o root -g wheel -m 0755 "$UPDATE_SRC" "$INSTALL_DIR/update.sh"
else
  echo "Development install: removing managed updater files..."
  rm -f "$INSTALL_DIR/update.sh" "$UPDATE_PLIST_PATH"
  launchctl disable "system/${UPDATE_LAUNCHD_LABEL}" >/dev/null 2>&1 || true
fi

echo "Creating the configuration directory..."
install -d \
  -o "$SERVICE_USER" \
  -g "$SERVICE_GROUP" \
  -m 0750 \
  "$CONFIG_DIR"

echo "Creating the gateway TLS directory..."
install -d \
  -o root \
  -g "$SERVICE_GROUP" \
  -m 0750 \
  "$TLS_DIR"

install_tls_file \
  "$SERVER_CA_SRC" \
  "$SERVER_CA_PATH" \
  "Shelly server CA certificate"

install_tls_file \
  "$CLIENT_CERT_SRC" \
  "$CLIENT_CERT_PATH" \
  "gateway client certificate"

install_tls_file \
  "$CLIENT_KEY_SRC" \
  "$CLIENT_KEY_PATH" \
  "gateway client private key"

if [[ ! -f "$CONFIG_PATH" ]]; then
  echo "Installing config.yaml..."
  install \
    -o "$SERVICE_USER" \
    -g "$SERVICE_GROUP" \
    -m 0640 \
    "$CONFIG_SRC" \
    "$CONFIG_PATH"
else
  echo "Existing config found; preserving:"
  echo "  $CONFIG_PATH"
  chown "$SERVICE_USER:$SERVICE_GROUP" "$CONFIG_PATH"
  chmod 0640 "$CONFIG_PATH"
fi

echo "Creating the log directory..."
install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" -m 0750 "$LOG_DIR"
touch \
  "$LOG_DIR/gateway.log" \
  "$LOG_DIR/gateway-error.log" \
  "$LOG_DIR/update.log" \
  "$LOG_DIR/update-error.log"
chown "$SERVICE_USER:$SERVICE_GROUP" \
  "$LOG_DIR/gateway.log" \
  "$LOG_DIR/gateway-error.log"
chown root:wheel \
  "$LOG_DIR/update.log" \
  "$LOG_DIR/update-error.log"
chmod 0640 \
  "$LOG_DIR/gateway.log" \
  "$LOG_DIR/gateway-error.log" \
  "$LOG_DIR/update.log" \
  "$LOG_DIR/update-error.log"

echo "Verifying configuration and TLS access as ${SERVICE_USER}..."
for readable_path in \
  "$CONFIG_PATH" \
  "$SERVER_CA_PATH" \
  "$CLIENT_CERT_PATH" \
  "$CLIENT_KEY_PATH"
do
  if ! sudo -u "$SERVICE_USER" test -r "$readable_path"; then
    echo "ERROR: Service account cannot read:"
    echo "  $readable_path"
    rollback_install
    exit 1
  fi
done

echo "Installing the gateway LaunchDaemon..."
install -o root -g wheel -m 0644 "$PLIST_SRC" "$PLIST_PATH"
plutil -lint "$PLIST_PATH" >/dev/null

if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  echo "Installing the update LaunchDaemon..."
  install -o root -g wheel -m 0644 "$UPDATE_PLIST_SRC" "$UPDATE_PLIST_PATH"
  plutil -lint "$UPDATE_PLIST_PATH" >/dev/null
fi

if ! configure_packet_filter; then
  rollback_install
  exit 1
fi

configure_application_firewall

echo "Loading and starting the gateway LaunchDaemon..."
if ! launchctl bootstrap system "$PLIST_PATH"; then
  rollback_install
  exit 1
fi
launchctl enable "system/${LAUNCHD_LABEL}" >/dev/null 2>&1 || true
launchctl kickstart -k "system/${LAUNCHD_LABEL}"

if ! wait_for_admin; then
  echo "ERROR: The Admin API did not become ready."
  rollback_install
  exit 1
fi

if [[ "$DEVELOPMENT_INSTALL" == false ]]; then
  echo "Loading the hourly update LaunchDaemon..."
  launchctl enable "system/${UPDATE_LAUNCHD_LABEL}" >/dev/null 2>&1 || true
  if ! launchctl bootstrap system "$UPDATE_PLIST_PATH"; then
    echo "ERROR: The update LaunchDaemon could not be loaded."
    rollback_install
    exit 1
  fi
else
  echo "Managed automatic updates remain disabled for development testing."
fi

echo
echo "Installed binary:"
"$INSTALL_DIR/$APP" -version
echo
echo "Gateway LaunchDaemon:"
launchctl print "system/${LAUNCHD_LABEL}" |
  sed -n '1,20p'
echo
echo "Admin API is responding at:"
echo "  ${ADMIN_STATUS_URL}"
echo
echo "Packet Filter permits only @FBS_SOURCE_IP@ to TCP ports @FBS_PORT_RANGE@."
echo "The macOS Application Firewall entry is also installed."
echo
if [[ "$DEVELOPMENT_INSTALL" == true ]]; then
  echo "Development install complete."
  echo "Run the normal install.sh to restore managed automatic updates."
else
  echo "Production install complete."
fi
