@echo off
setlocal EnableExtensions

set "INSTALL_DIR=@WINDOWS_INSTALL_DIR@"
set "LOG_DIR=@WINDOWS_LOG_DIR@"
set "INSTALL_DIR=%INSTALL_DIR:/=\%"
set "LOG_DIR=%LOG_DIR:/=\%"

if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"

powershell.exe ^
    -NoLogo ^
    -NoProfile ^
    -NonInteractive ^
    -ExecutionPolicy Bypass ^
    -File "%INSTALL_DIR%\update.ps1" ^
    1>>"%LOG_DIR%\update.log" ^
    2>>"%LOG_DIR%\update-error.log"

exit /b %errorlevel%
