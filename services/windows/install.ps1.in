#Requires -Version 5.1

[CmdletBinding()]
param(
    [switch]$Development
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

$AppName = '@APP@'
$TaskName = 'FBS Interlock Gateway'
$UpdateTaskName = 'FBS Interlock Gateway Update'
$LegacyFirewallRuleName = 'FBS Interlock Gateway'
$FirewallRuleName = 'FBS Interlock Gateway - Authorized FBS Source'

$InstallDirectory = [IO.Path]::GetFullPath('@WINDOWS_INSTALL_DIR@')
$ConfigDirectory = [IO.Path]::GetFullPath('@WINDOWS_CONFIG_DIR@')
$ConfigPath = [IO.Path]::GetFullPath('@WINDOWS_CONFIG_PATH@')
$TlsDirectory = [IO.Path]::GetFullPath('@WINDOWS_TLS_DIR@')
$LogDirectory = [IO.Path]::GetFullPath('@WINDOWS_LOG_DIR@')

$FbsSourceIp = '@FBS_SOURCE_IP@'
$FbsPortRange = '@FBS_PORT_RANGE@'.Replace(':', '-')
$AdminStatusUrl = 'http://127.0.0.1:18090/api/status'

$SourceDirectory = Split-Path -Parent $MyInvocation.MyCommand.Path
$ExecutableName = "$AppName.exe"
$ExecutableSource = Join-Path $SourceDirectory $ExecutableName
$ExecutableDestination = Join-Path $InstallDirectory $ExecutableName
$ConfigSource = Join-Path $SourceDirectory 'config.yaml'
$StartScriptSource = Join-Path $SourceDirectory 'start.bat'
$StartScriptDestination = Join-Path $InstallDirectory 'start.bat'
$UpdateScriptSource = Join-Path $SourceDirectory 'update.ps1'
$UpdateScriptDestination = Join-Path $InstallDirectory 'update.ps1'
$UpdateBatchSource = Join-Path $SourceDirectory 'update.bat'
$UpdateBatchDestination = Join-Path $InstallDirectory 'update.bat'
$TlsSourceDirectory = Join-Path $SourceDirectory 'tls'

$ServerCaSource = Join-Path $TlsSourceDirectory 'server-ca.crt'
$ClientCertificateSource = Join-Path $TlsSourceDirectory 'gateway-client.crt'
$ClientKeySource = Join-Path $TlsSourceDirectory 'gateway-client.key'
$ServerCaDestination = Join-Path $TlsDirectory 'server-ca.crt'
$ClientCertificateDestination = Join-Path $TlsDirectory 'gateway-client.crt'
$ClientKeyDestination = Join-Path $TlsDirectory 'gateway-client.key'

$SystemSid = [Security.Principal.SecurityIdentifier]::new('S-1-5-18')
$AdministratorsSid = [Security.Principal.SecurityIdentifier]::new('S-1-5-32-544')
$LocalServiceSid = [Security.Principal.SecurityIdentifier]::new('S-1-5-19')
$LocalServiceAccount = $LocalServiceSid.Translate(
    [Security.Principal.NTAccount]
).Value

function Assert-Administrator {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = [Security.Principal.WindowsPrincipal]::new($identity)

    if (-not $principal.IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator
    )) {
        throw 'Administrator privileges are required to install the gateway.'
    }
}

function Assert-DeploymentFile {
    param(
        [Parameter(Mandatory)]
        [string]$Path,

        [Parameter(Mandatory)]
        [string]$Description
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        throw "Missing $Description: $Path"
    }
}

function Get-PeMachine {
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    $reader = $null
    $stream = [IO.File]::Open(
        $Path,
        [IO.FileMode]::Open,
        [IO.FileAccess]::Read,
        [IO.FileShare]::Read
    )

    try {
        $reader = [IO.BinaryReader]::new($stream)

        if ($reader.ReadUInt16() -ne 0x5A4D) {
            throw "The file is not a Windows PE executable: $Path"
        }

        $stream.Position = 0x3C
        $peOffset = $reader.ReadInt32()
        $stream.Position = $peOffset

        if ($reader.ReadUInt32() -ne 0x00004550) {
            throw "The file has an invalid PE signature: $Path"
        }

        return $reader.ReadUInt16()
    }
    finally {
        if ($null -ne $reader) {
            $reader.Dispose()
        }
        $stream.Dispose()
    }
}

function Assert-Amd64Binary {
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    if (-not [Environment]::Is64BitOperatingSystem) {
        throw 'The Windows amd64 deployment requires a 64-bit version of Windows.'
    }

    $machine = Get-PeMachine -Path $Path
    if ($machine -ne 0x8664) {
        throw ('The deployment executable is not amd64. PE machine: 0x{0:X4}' -f $machine)
    }

    Write-Host 'Validating the application executable...'
    $versionOutput = & $Path -version 2>&1
    if ($LASTEXITCODE -ne 0) {
        throw "The application executable failed validation with exit code $LASTEXITCODE."
    }

    $versionText = ($versionOutput | Out-String).Trim()
    if ($versionText) {
        Write-Host $versionText
    }
}

function New-DirectoryIfMissing {
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    New-Item -ItemType Directory -Path $Path -Force | Out-Null
}

function Add-DirectoryAccessRule {
    param(
        [Parameter(Mandatory)]
        [Security.AccessControl.DirectorySecurity]$Acl,

        [Parameter(Mandatory)]
        [Security.Principal.SecurityIdentifier]$Identity,

        [Parameter(Mandatory)]
        [Security.AccessControl.FileSystemRights]$Rights
    )

    $inheritance = [Security.AccessControl.InheritanceFlags]::ContainerInherit -bor
        [Security.AccessControl.InheritanceFlags]::ObjectInherit

    $rule = [System.Security.AccessControl.FileSystemAccessRule]::new(
        $Identity,
        $Rights,
        $inheritance,
        [Security.AccessControl.PropagationFlags]::None,
        [Security.AccessControl.AccessControlType]::Allow
    )

    [void]$Acl.AddAccessRule($rule)
}

function Set-RestrictedDirectoryAcl {
    param(
        [Parameter(Mandatory)]
        [string]$Path,

        [Parameter(Mandatory)]
        [Security.AccessControl.FileSystemRights]$ServiceRights
    )

    $acl = Get-Acl -LiteralPath $Path
    $acl.SetAccessRuleProtection($true, $false)

    foreach ($rule in @($acl.Access)) {
        [void]$acl.RemoveAccessRuleSpecific($rule)
    }

    Add-DirectoryAccessRule `
        -Acl $acl `
        -Identity $SystemSid `
        -Rights ([Security.AccessControl.FileSystemRights]::FullControl)

    Add-DirectoryAccessRule `
        -Acl $acl `
        -Identity $AdministratorsSid `
        -Rights ([Security.AccessControl.FileSystemRights]::FullControl)

    Add-DirectoryAccessRule `
        -Acl $acl `
        -Identity $LocalServiceSid `
        -Rights $ServiceRights

    Set-Acl -LiteralPath $Path -AclObject $acl
}

function Set-RestrictedFileAcl {
    param(
        [Parameter(Mandatory)]
        [string]$Path,

        [Parameter(Mandatory)]
        [Security.AccessControl.FileSystemRights]$ServiceRights
    )

    $acl = Get-Acl -LiteralPath $Path
    $acl.SetAccessRuleProtection($true, $false)

    foreach ($rule in @($acl.Access)) {
        [void]$acl.RemoveAccessRuleSpecific($rule)
    }

    $systemRule = [System.Security.AccessControl.FileSystemAccessRule]::new(
        $SystemSid,
        [Security.AccessControl.FileSystemRights]::FullControl,
        [Security.AccessControl.AccessControlType]::Allow
    )
    $administratorsRule = [System.Security.AccessControl.FileSystemAccessRule]::new(
        $AdministratorsSid,
        [Security.AccessControl.FileSystemRights]::FullControl,
        [Security.AccessControl.AccessControlType]::Allow
    )
    $serviceRule = [System.Security.AccessControl.FileSystemAccessRule]::new(
        $LocalServiceSid,
        $ServiceRights,
        [Security.AccessControl.AccessControlType]::Allow
    )

    [void]$acl.AddAccessRule($systemRule)
    [void]$acl.AddAccessRule($administratorsRule)
    [void]$acl.AddAccessRule($serviceRule)

    Set-Acl -LiteralPath $Path -AclObject $acl
}

function Install-TlsFile {
    param(
        [Parameter(Mandatory)]
        [string]$Source,

        [Parameter(Mandatory)]
        [string]$Destination,

        [Parameter(Mandatory)]
        [string]$Description
    )

    if (Test-Path -LiteralPath $Destination -PathType Leaf) {
        Write-Host "Existing $Description found; preserving:"
        Write-Host "  $Destination"
    }
    else {
        Write-Host "Installing $Description..."
        Copy-Item -LiteralPath $Source -Destination $Destination -Force
    }
}

function Get-TaskXml {
    param([string]$Name)

    try {
        return Export-ScheduledTask -TaskName $Name -ErrorAction Stop
    }
    catch {
        return $null
    }
}

function Test-TaskRunning {
    param([string]$Name)

    $task = Get-ScheduledTask -TaskName $Name -ErrorAction SilentlyContinue
    return ($null -ne $task -and $task.State -eq 'Running')
}

function Stop-TaskIfPresent {
    param([string]$Name)

    Stop-ScheduledTask -TaskName $Name -ErrorAction SilentlyContinue
}

function Remove-TaskIfPresent {
    param([string]$Name)

    Unregister-ScheduledTask `
        -TaskName $Name `
        -Confirm:$false `
        -ErrorAction SilentlyContinue
}

function Stop-GatewayProcesses {
    Write-Host 'Stopping existing gateway and update tasks...'
    Stop-TaskIfPresent -Name $UpdateTaskName
    Stop-TaskIfPresent -Name $TaskName

    Get-Process -Name $AppName -ErrorAction SilentlyContinue |
        Stop-Process -Force -ErrorAction SilentlyContinue

    Start-Sleep -Seconds 1
}

function Backup-Path {
    param(
        [string]$Path,
        [string]$Key,
        [string]$BackupDirectory
    )

    if (Test-Path -LiteralPath $Path -PathType Leaf) {
        Copy-Item `
            -LiteralPath $Path `
            -Destination (Join-Path $BackupDirectory $Key) `
            -Force
    }
    else {
        New-Item `
            -ItemType File `
            -Path (Join-Path $BackupDirectory "$Key.absent") `
            -Force |
            Out-Null
    }
}

function Restore-Path {
    param(
        [string]$Path,
        [string]$Key,
        [string]$BackupDirectory
    )

    $backupPath = Join-Path $BackupDirectory $Key
    $absentPath = Join-Path $BackupDirectory "$Key.absent"

    if (Test-Path -LiteralPath $backupPath -PathType Leaf) {
        Copy-Item -LiteralPath $backupPath -Destination $Path -Force
    }
    elseif (Test-Path -LiteralPath $absentPath -PathType Leaf) {
        Remove-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue
    }
}

function Install-ApplicationFiles {
    Write-Host "Creating installation directory: $InstallDirectory"
    New-DirectoryIfMissing -Path $InstallDirectory
    New-DirectoryIfMissing -Path $ConfigDirectory
    New-DirectoryIfMissing -Path $TlsDirectory
    New-DirectoryIfMissing -Path $LogDirectory

    Write-Host "Installing $ExecutableName..."
    Copy-Item `
        -LiteralPath $ExecutableSource `
        -Destination $ExecutableDestination `
        -Force

    Write-Host 'Installing start.bat...'
    Copy-Item `
        -LiteralPath $StartScriptSource `
        -Destination $StartScriptDestination `
        -Force

    if (Test-Path -LiteralPath $ConfigPath -PathType Leaf) {
        Write-Host 'Existing production configuration found; preserving:'
        Write-Host "  $ConfigPath"
    }
    else {
        Write-Host 'Installing the initial config.yaml...'
        Copy-Item -LiteralPath $ConfigSource -Destination $ConfigPath -Force
    }

    Install-TlsFile `
        -Source $ServerCaSource `
        -Destination $ServerCaDestination `
        -Description 'Shelly server CA certificate'

    Install-TlsFile `
        -Source $ClientCertificateSource `
        -Destination $ClientCertificateDestination `
        -Description 'gateway client certificate'

    Install-TlsFile `
        -Source $ClientKeySource `
        -Destination $ClientKeyDestination `
        -Description 'gateway client private key'

    foreach ($logName in @(
        'gateway.log',
        'gateway-error.log',
        'update.log',
        'update-error.log'
    )) {
        $logPath = Join-Path $LogDirectory $logName
        if (-not (Test-Path -LiteralPath $logPath -PathType Leaf)) {
            New-Item -ItemType File -Path $logPath -Force | Out-Null
        }
    }

    if ($Development) {
        Write-Host 'Development install: removing managed updater files...'
        Remove-Item `
            -LiteralPath $UpdateScriptDestination `
            -Force `
            -ErrorAction SilentlyContinue
        Remove-Item `
            -LiteralPath $UpdateBatchDestination `
            -Force `
            -ErrorAction SilentlyContinue
    }
    else {
        Write-Host 'Installing the checksum-aware updater...'
        Copy-Item `
            -LiteralPath $UpdateScriptSource `
            -Destination $UpdateScriptDestination `
            -Force
        Copy-Item `
            -LiteralPath $UpdateBatchSource `
            -Destination $UpdateBatchDestination `
            -Force
    }
}

function Set-InstalledPermissions {
    Write-Host "Restricting installed files to Administrators, SYSTEM, and $LocalServiceAccount..."

    Set-RestrictedDirectoryAcl `
        -Path $InstallDirectory `
        -ServiceRights ([Security.AccessControl.FileSystemRights]::ReadAndExecute)

    if ($ConfigDirectory -ne $InstallDirectory) {
        Set-RestrictedDirectoryAcl `
            -Path $ConfigDirectory `
            -ServiceRights ([Security.AccessControl.FileSystemRights]::ReadAndExecute)
    }

    Set-RestrictedDirectoryAcl `
        -Path $TlsDirectory `
        -ServiceRights ([Security.AccessControl.FileSystemRights]::ReadAndExecute)

    Set-RestrictedDirectoryAcl `
        -Path $LogDirectory `
        -ServiceRights ([Security.AccessControl.FileSystemRights]::Modify)

    Set-RestrictedFileAcl `
        -Path $ExecutableDestination `
        -ServiceRights ([Security.AccessControl.FileSystemRights]::ReadAndExecute)

    Set-RestrictedFileAcl `
        -Path $StartScriptDestination `
        -ServiceRights ([Security.AccessControl.FileSystemRights]::ReadAndExecute)

    Set-RestrictedFileAcl `
        -Path $ConfigPath `
        -ServiceRights ([Security.AccessControl.FileSystemRights]::Read)

    foreach ($tlsPath in @(
        $ServerCaDestination,
        $ClientCertificateDestination,
        $ClientKeyDestination
    )) {
        Set-RestrictedFileAcl `
            -Path $tlsPath `
            -ServiceRights ([Security.AccessControl.FileSystemRights]::Read)
    }

    if (-not $Development) {
        Set-RestrictedFileAcl `
            -Path $UpdateScriptDestination `
            -ServiceRights ([Security.AccessControl.FileSystemRights]::ReadAndExecute)
        Set-RestrictedFileAcl `
            -Path $UpdateBatchDestination `
            -ServiceRights ([Security.AccessControl.FileSystemRights]::ReadAndExecute)
    }
}

function Install-FirewallRule {
    Write-Host 'Configuring Windows Defender Firewall...'

    Set-NetFirewallProfile `
        -Profile Domain, Private, Public `
        -DefaultInboundAction Block

    foreach ($ruleName in @($LegacyFirewallRuleName, $FirewallRuleName)) {
        Get-NetFirewallRule `
            -DisplayName $ruleName `
            -ErrorAction SilentlyContinue |
            Remove-NetFirewallRule -ErrorAction SilentlyContinue
    }

    New-NetFirewallRule `
        -DisplayName $FirewallRuleName `
        -Description "Allows $FbsSourceIp to reach the FBS gateway listener range only." `
        -Direction Inbound `
        -Program $ExecutableDestination `
        -Protocol TCP `
        -LocalPort $FbsPortRange `
        -RemoteAddress $FbsSourceIp `
        -Action Allow `
        -Profile Any `
        -EdgeTraversalPolicy Block |
        Out-Null
}

function Install-GatewayTask {
    Write-Host "Registering the gateway startup task as $LocalServiceAccount..."

    $taskArgument = '/d /c ""{0}""' -f $StartScriptDestination

    $action = New-ScheduledTaskAction `
        -Execute "$env:SystemRoot\System32\cmd.exe" `
        -Argument $taskArgument `
        -WorkingDirectory $ConfigDirectory

    $trigger = New-ScheduledTaskTrigger -AtStartup

    $principal = New-ScheduledTaskPrincipal `
        -UserId $LocalServiceAccount `
        -LogonType ServiceAccount `
        -RunLevel Limited

    $settings = New-ScheduledTaskSettingsSet `
        -AllowStartIfOnBatteries `
        -DontStopIfGoingOnBatteries `
        -StartWhenAvailable `
        -RestartCount 10 `
        -RestartInterval (New-TimeSpan -Minutes 1) `
        -ExecutionTimeLimit ([TimeSpan]::Zero) `
        -MultipleInstances IgnoreNew

    Register-ScheduledTask `
        -TaskName $TaskName `
        -Action $action `
        -Trigger $trigger `
        -Principal $principal `
        -Settings $settings `
        -Description 'Runs the FBS Interlock Gateway at startup under LOCAL SERVICE.' `
        -Force |
        Out-Null
}

function Install-UpdateTask {
    if ($Development) {
        Write-Host 'Managed automatic updates remain disabled for development testing.'
        Remove-TaskIfPresent -Name $UpdateTaskName
        return
    }

    Write-Host 'Registering the hourly checksum update task as SYSTEM...'

    $taskArgument = '/d /c ""{0}""' -f $UpdateBatchDestination

    $action = New-ScheduledTaskAction `
        -Execute "$env:SystemRoot\System32\cmd.exe" `
        -Argument $taskArgument `
        -WorkingDirectory $InstallDirectory

    $triggerStart = [DateTime]::Today.AddMinutes(17)
    $repetitionTemplate = New-ScheduledTaskTrigger `
        -Once `
        -At $triggerStart `
        -RepetitionInterval (New-TimeSpan -Hours 1) `
        -RepetitionDuration (New-TimeSpan -Days 1)

    $trigger = New-ScheduledTaskTrigger -Daily -At $triggerStart
    $trigger.Repetition = $repetitionTemplate.Repetition

    $principal = New-ScheduledTaskPrincipal `
        -UserId 'SYSTEM' `
        -LogonType ServiceAccount `
        -RunLevel Highest

    $settings = New-ScheduledTaskSettingsSet `
        -AllowStartIfOnBatteries `
        -DontStopIfGoingOnBatteries `
        -StartWhenAvailable `
        -ExecutionTimeLimit (New-TimeSpan -Minutes 30) `
        -MultipleInstances IgnoreNew

    Register-ScheduledTask `
        -TaskName $UpdateTaskName `
        -Action $action `
        -Trigger $trigger `
        -Principal $principal `
        -Settings $settings `
        -Description 'Checks GitHub Releases hourly and installs a verified gateway binary when needed.' `
        -Force |
        Out-Null
}

function Wait-ForAdminApi {
    param([int]$Attempts = 20)

    for ($attempt = 1; $attempt -le $Attempts; $attempt++) {
        try {
            $response = Invoke-WebRequest `
                -Uri $AdminStatusUrl `
                -UseBasicParsing `
                -TimeoutSec 2

            if ($response.StatusCode -ge 200 -and $response.StatusCode -lt 300) {
                return $true
            }
        }
        catch {
            Start-Sleep -Seconds 1
        }
    }

    return $false
}

function Restore-PreviousInstallation {
    param(
        [string]$BackupDirectory,
        [string]$MainTaskXml,
        [string]$UpdaterTaskXml,
        [bool]$MainTaskWasRunning
    )

    Write-Warning 'Rolling back the failed Windows installation.'

    Stop-TaskIfPresent -Name $UpdateTaskName
    Stop-TaskIfPresent -Name $TaskName
    Remove-TaskIfPresent -Name $UpdateTaskName
    Remove-TaskIfPresent -Name $TaskName

    Get-Process -Name $AppName -ErrorAction SilentlyContinue |
        Stop-Process -Force -ErrorAction SilentlyContinue

    Restore-Path -Path $ExecutableDestination -Key 'app.exe' -BackupDirectory $BackupDirectory
    Restore-Path -Path $StartScriptDestination -Key 'start.bat' -BackupDirectory $BackupDirectory
    Restore-Path -Path $UpdateScriptDestination -Key 'update.ps1' -BackupDirectory $BackupDirectory
    Restore-Path -Path $UpdateBatchDestination -Key 'update.bat' -BackupDirectory $BackupDirectory

    if ($MainTaskXml) {
        Register-ScheduledTask `
            -TaskName $TaskName `
            -Xml $MainTaskXml `
            -Force |
            Out-Null
    }

    if ($UpdaterTaskXml) {
        Register-ScheduledTask `
            -TaskName $UpdateTaskName `
            -Xml $UpdaterTaskXml `
            -Force |
            Out-Null
    }

    if ($MainTaskWasRunning -and $MainTaskXml) {
        Start-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
    }
}

Assert-Administrator

Assert-DeploymentFile -Path $ExecutableSource -Description 'application executable'
Assert-DeploymentFile -Path $ConfigSource -Description 'config.yaml'
Assert-DeploymentFile -Path $StartScriptSource -Description 'startup script'
Assert-DeploymentFile -Path $ServerCaSource -Description 'Shelly server CA certificate'
Assert-DeploymentFile -Path $ClientCertificateSource -Description 'gateway client certificate'
Assert-DeploymentFile -Path $ClientKeySource -Description 'gateway client private key'

if (-not $Development) {
    Assert-DeploymentFile -Path $UpdateScriptSource -Description 'update PowerShell script'
    Assert-DeploymentFile -Path $UpdateBatchSource -Description 'update launcher'
}

Assert-Amd64Binary -Path $ExecutableSource

Write-Host ''
Write-Host 'FBS Interlock Gateway Windows Installer'
Write-Host '========================================'
if ($Development) {
    Write-Host 'Mode: development'
}
else {
    Write-Host 'Mode: production'
}
Write-Host ''

$backupDirectory = Join-Path $env:TEMP (
    '{0}-install-backup-{1}' -f $AppName, [Guid]::NewGuid().ToString('N')
)
New-DirectoryIfMissing -Path $backupDirectory

$mainTaskXml = Get-TaskXml -Name $TaskName
$updaterTaskXml = Get-TaskXml -Name $UpdateTaskName
$mainTaskWasRunning = Test-TaskRunning -Name $TaskName

try {
    Stop-GatewayProcesses

    Backup-Path -Path $ExecutableDestination -Key 'app.exe' -BackupDirectory $backupDirectory
    Backup-Path -Path $StartScriptDestination -Key 'start.bat' -BackupDirectory $backupDirectory
    Backup-Path -Path $UpdateScriptDestination -Key 'update.ps1' -BackupDirectory $backupDirectory
    Backup-Path -Path $UpdateBatchDestination -Key 'update.bat' -BackupDirectory $backupDirectory

    Install-ApplicationFiles
    Set-InstalledPermissions
    Install-FirewallRule
    Install-GatewayTask
    Install-UpdateTask

    Write-Host 'Starting the gateway...'
    Start-ScheduledTask -TaskName $TaskName

    if (-not (Wait-ForAdminApi)) {
        throw "The Admin API did not become ready at $AdminStatusUrl."
    }

    Write-Host ''
    Write-Host 'Installed executable:'
    & $ExecutableDestination -version

    Write-Host ''
    Write-Host "Gateway task: $TaskName"
    Get-ScheduledTask -TaskName $TaskName |
        Select-Object TaskName, State, Author |
        Format-Table -AutoSize

    if (-not $Development) {
        Write-Host "Update task:  $UpdateTaskName"
        Get-ScheduledTask -TaskName $UpdateTaskName |
            Select-Object TaskName, State, Author |
            Format-Table -AutoSize
    }

    Write-Host ''
    Write-Host "Admin API is responding at: $AdminStatusUrl"
    Write-Host "Firewall permits only $FbsSourceIp to TCP ports $FbsPortRange."
    Write-Host "Gateway runtime account: $LocalServiceAccount"
    Write-Host ''

    if ($Development) {
        Write-Host 'Development install complete.'
        Write-Host 'Run install.bat to restore managed automatic updates.'
    }
    else {
        Write-Host 'Production install complete.'
    }
}
catch {
    $installationError = $_

    try {
        Restore-PreviousInstallation `
            -BackupDirectory $backupDirectory `
            -MainTaskXml $mainTaskXml `
            -UpdaterTaskXml $updaterTaskXml `
            -MainTaskWasRunning $mainTaskWasRunning
    }
    catch {
        Write-Warning "Rollback also reported an error: $($_.Exception.Message)"
    }

    throw $installationError
}
finally {
    Remove-Item -LiteralPath $backupDirectory -Recurse -Force -ErrorAction SilentlyContinue
}
