@echo off
setlocal EnableExtensions

net session >nul 2>&1
if %errorlevel% neq 0 (
    echo.
    echo Administrator privileges are required.
    echo Right-click install-dev.bat and select "Run as administrator."
    echo.
    pause
    exit /b 1
)

powershell.exe ^
    -NoLogo ^
    -NoProfile ^
    -ExecutionPolicy Bypass ^
    -File "%~dp0install.ps1" ^
    -Development

if %errorlevel% neq 0 (
    echo.
    echo Development installation failed.
    pause
    exit /b 1
)

echo.
echo Development installation completed successfully.
pause
