@echo off
setlocal EnableExtensions

net session >nul 2>&1
if %errorlevel% neq 0 (
    echo.
    echo Administrator privileges are required.
    echo Right-click uninstall.bat and select "Run as administrator."
    echo.
    pause
    exit /b 1
)

set "UNINSTALL_ARGUMENT="
if /I "%~1"=="--purge" set "UNINSTALL_ARGUMENT=-Purge"
if /I "%~1"=="-Purge" set "UNINSTALL_ARGUMENT=-Purge"
if not "%~1"=="" if not defined UNINSTALL_ARGUMENT (
    echo.
    echo Unknown option: %~1
    echo Usage: uninstall.bat [--purge]
    echo.
    pause
    exit /b 2
)

powershell.exe ^
    -NoLogo ^
    -NoProfile ^
    -ExecutionPolicy Bypass ^
    -File "%~dp0uninstall.ps1" ^
    %UNINSTALL_ARGUMENT%

if %errorlevel% neq 0 (
    echo.
    echo Uninstallation failed.
    pause
    exit /b 1
)

echo.
echo Uninstallation completed successfully.
pause
