@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "INSTALL_DIR=@WINDOWS_INSTALL_DIR@"
set "CONFIG_DIR=@WINDOWS_CONFIG_DIR@"
set "CONFIG_PATH=@WINDOWS_CONFIG_PATH@"
set "LOG_DIR=@WINDOWS_LOG_DIR@"

set "INSTALL_DIR=!INSTALL_DIR:/=\!"
set "CONFIG_DIR=!CONFIG_DIR:/=\!"
set "CONFIG_PATH=!CONFIG_PATH:/=\!"
set "LOG_DIR=!LOG_DIR:/=\!"

cd /d "!CONFIG_DIR!" || exit /b 1

if not exist "!LOG_DIR!" mkdir "!LOG_DIR!"

set "APP_PATH=!INSTALL_DIR!\@APP@.exe"
set "LOG_FILE=!LOG_DIR!\gateway.log"
set "ERROR_LOG_FILE=!LOG_DIR!\gateway-error.log"

set "RESTART_DELAY_SECONDS=2"
set "START_LIMIT_INTERVAL_SECONDS=60"
set "START_LIMIT_BURST=10"

set "START_WINDOW="
set /a START_COUNT=0

:restart
for /f %%I in ('powershell.exe -NoLogo -NoProfile -NonInteractive -Command "[DateTimeOffset]::UtcNow.ToUnixTimeSeconds()"') do (
    set "CURRENT_TIME=%%I"
)

if not defined START_WINDOW (
    set "START_WINDOW=!CURRENT_TIME!"
    set /a START_COUNT=0
)

set /a WINDOW_AGE=CURRENT_TIME-START_WINDOW

if !WINDOW_AGE! GEQ !START_LIMIT_INTERVAL_SECONDS! (
    set "START_WINDOW=!CURRENT_TIME!"
    set /a START_COUNT=0
)

set /a START_COUNT+=1

if !START_COUNT! GTR !START_LIMIT_BURST! (
    echo [%date% %time%] Restart limit exceeded: more than !START_LIMIT_BURST! starts in !START_LIMIT_INTERVAL_SECONDS! seconds.>>"!ERROR_LOG_FILE!"
    exit /b 1
)

echo [%date% %time%] Starting @APP@.exe, attempt !START_COUNT! in the current restart window.>>"!LOG_FILE!"

"!APP_PATH!" -config "!CONFIG_PATH!" 1>>"!LOG_FILE!" 2>>"!ERROR_LOG_FILE!"
set "EXIT_CODE=!ERRORLEVEL!"

echo [%date% %time%] @APP@.exe exited with code !EXIT_CODE!. Restarting in !RESTART_DELAY_SECONDS! seconds.>>"!ERROR_LOG_FILE!"

timeout.exe /t !RESTART_DELAY_SECONDS! /nobreak >nul
goto restart
